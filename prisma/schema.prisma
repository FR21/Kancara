generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED") // Wajib untuk migrasi dengan Neon Connection Pooling
}

model User {
  id    String @id // Ini akan diisi oleh UID Firebase Auth
  email String?
  
  // Relasi
  trips Trip[]
}

model Trip {
  id           String   @id @default(uuid())
  userId       String
  name         String
  state        String   // Misal: "PLANNED", "DRAFT", "COMPLETED"
  role         String   // Misal: "organizer", "member"
  countryCodes String[] // PostgreSQL mendukung Array String
  
  // Data JSON kompleks
  draft        Json     
  itinerary    Json?    
  today        Json?    // TripActivity[] yang diserialisasi ke JSON
  
  // Kolom opsional tambahan (untuk fitur masa depan yang tercantum di Trip.ts)
  violations   Int?
  offline      String?  // OfflineState
  spent        Int?
  
  updatedAt    DateTime @default(now()) @updatedAt
  
  // Relasi
  user         User     @relation(fields: [userId], references: [id])
}

model ApiCache {
  key       String   @id // contoh: "booking:stays:jakarta"
  data      Json
  expiresAt DateTime
  createdAt DateTime @default(now())
}
