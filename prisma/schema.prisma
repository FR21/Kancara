// The tables the app uses. Conventions (see "Database" in the README):
// - tables are plural snake_case; columns are snake_case
// - a primary key is the table's singular name plus _id, and is a UUID
// - a foreign key has the same name as the primary key it points to
// - every table has created_at and updated_at, stored in UTC
// - rows people delete are soft-deleted through deleted_at
// - tables that hold a workspace's data carry workspace_id, and every query filters on it
// CHECK constraints and the case-insensitive unique index on users.username cannot be written in this file;
// they exist in the database only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED") // Schema changes need a direct connection; the app uses the pooled one.
}

/// A person who signs in. Firebase Auth owns the sign-in; `firebaseUid` ties its account to this row.
model User {
  userId          String    @id @default(dbgenerated("gen_random_uuid()")) @map("user_id") @db.Uuid
  firebaseUid     String    @unique @map("firebase_uid")
  email           String?
  displayName     String?   @map("display_name")
  username        String?
  /// The country the person is from, as its two-letter code. Rows from before the country picker hold free text.
  nationality     String?
  age             Int?      @db.SmallInt
  gender          String?
  /// The person's own phone number, sealed (see lib/secret-box). It goes with them into the trips they join.
  phoneNumberCipher String? @map("phone_number_cipher")
  /// Where the profile photo sits in object storage, when the person uploaded one.
  avatarObjectKey String?   @map("avatar_object_key")
  avatarUpdatedAt DateTime? @map("avatar_updated_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  workspaces       Workspace[]
  trips            Trip[]
  visitedCountries VisitedCountry[]
  tripMembers      TripMember[]
  pushSubscriptions PushSubscription[]
  savedMemberProfiles SavedMemberProfile[]
  splitBills        SplitBill[]
  tripMemories      TripMemory[]

  @@map("users")
}

/// The space a person's trips live in. Everyone gets one of their own; `userId` is its owner.
model Workspace {
  workspaceId String    @id @default(dbgenerated("gen_random_uuid()")) @map("workspace_id") @db.Uuid
  userId      String    @unique @map("user_id") @db.Uuid
  name        String
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  user               User                @relation(fields: [userId], references: [userId], onDelete: Restrict)
  trips              Trip[]
  visitedCountries   VisitedCountry[]
  tripMembers        TripMember[]
  pushSubscriptions  PushSubscription[]
  savedMemberProfiles SavedMemberProfile[]
  splitBills         SplitBill[]
  splitBillMembers   SplitBillMember[]
  splitBillExpenses  SplitBillExpense[]
  splitBillShares    SplitBillExpenseShare[]
  splitBillSettlements SplitBillSettlement[]
  tripMemories       TripMemory[]
  tripFieldPasses    TripFieldPass[]
  tripSafetySettings TripSafetySetting[]
  missingReports     MissingReport[]
  emergencyContacts  EmergencyContact[]

  @@map("workspaces")
}

/// A saved trip. The columns are what lists filter and sort on; the plan itself is a document in `planDraft`.
model Trip {
  tripId          String    @id @default(dbgenerated("gen_random_uuid()")) @map("trip_id") @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  /// The person who saved the trip.
  userId          String    @map("user_id") @db.Uuid
  name            String
  state           String
  role            String
  origin          String    @default("")
  destinations    String[]  @default([])
  startDate       DateTime? @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  countryCodes    String[]  @default([]) @map("country_codes")
  violationCount  Int?      @map("violation_count")
  offlineState    String?   @map("offline_state")
  spentRupiah     BigInt?   @map("spent_rupiah")
  planDraft       Json      @map("plan_draft")
  itinerary       Json?
  todayActivities Json?     @map("today_activities")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  workspace         Workspace          @relation(fields: [workspaceId], references: [workspaceId], onDelete: Restrict)
  user              User               @relation(fields: [userId], references: [userId], onDelete: Restrict)
  members           TripMember[]
  safetySetting     TripSafetySetting?
  missingReports    MissingReport[]
  emergencyContacts EmergencyContact[]
  splitBills        SplitBill[]
  memories          TripMemory[]
  fieldPasses       TripFieldPass[]

  @@index([workspaceId, state, startDate])
  @@index([workspaceId, updatedAt(sort: Desc)])
  @@map("trips")
}

/// A person's travel companion, kept to fill in a plan's group without asking again. Health notes are sealed.
model SavedMemberProfile {
  savedMemberProfileId String    @id @default(dbgenerated("gen_random_uuid()")) @map("saved_member_profile_id") @db.Uuid
  workspaceId          String    @map("workspace_id") @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  name                 String
  relationship         String    @default("")
  ageGroup             String    @map("age_group")
  age                  Int?      @db.SmallInt
  needs                String[]  @default([])
  customNeeds          String[]  @default([]) @map("custom_needs")
  /// Encrypted before it is stored; see lib/secret-box.ts.
  allergiesCipher      String?   @map("allergies_cipher")
  interests            Json      @default("{}")
  customInterests      Json      @default("[]") @map("custom_interests")
  /// Encrypted before it is stored; see lib/secret-box.ts.
  notesCipher          String?   @map("notes_cipher")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [workspaceId], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [userId], onDelete: Restrict)

  @@index([workspaceId])
  @@map("saved_member_profiles")
}

/// A bill shared by a group: who is in it, what each paid, who shared what, and which debts are settled.
model SplitBill {
  splitBillId String    @id @default(dbgenerated("gen_random_uuid()")) @map("split_bill_id") @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tripId      String?   @map("trip_id") @db.Uuid
  title       String    @default("")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  workspace   Workspace             @relation(fields: [workspaceId], references: [workspaceId], onDelete: Restrict)
  user        User                  @relation(fields: [userId], references: [userId], onDelete: Restrict)
  trip        Trip?                 @relation(fields: [tripId], references: [tripId], onDelete: Restrict)
  members     SplitBillMember[]
  expenses    SplitBillExpense[]
  settlements SplitBillSettlement[]

  @@index([workspaceId])
  @@map("split_bills")
}

model SplitBillMember {
  splitBillMemberId String    @id @default(dbgenerated("gen_random_uuid()")) @map("split_bill_member_id") @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  splitBillId       String    @map("split_bill_id") @db.Uuid
  name              String
  position          Int       @default(0)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  workspace       Workspace               @relation(fields: [workspaceId], references: [workspaceId], onDelete: Restrict)
  splitBill       SplitBill               @relation(fields: [splitBillId], references: [splitBillId], onDelete: Restrict)
  paid            SplitBillExpense[]
  shares          SplitBillExpenseShare[]
  settlementsFrom SplitBillSettlement[]   @relation("SettlementFrom")
  settlementsTo   SplitBillSettlement[]   @relation("SettlementTo")

  @@index([workspaceId])
  @@map("split_bill_members")
}

model SplitBillExpense {
  splitBillExpenseId String    @id @default(dbgenerated("gen_random_uuid()")) @map("split_bill_expense_id") @db.Uuid
  workspaceId        String    @map("workspace_id") @db.Uuid
  splitBillId        String    @map("split_bill_id") @db.Uuid
  paidByMemberId     String    @map("paid_by_member_id") @db.Uuid
  description        String
  category           String    @default("other")
  amount             Decimal   @db.Decimal(14, 2)
  /// What was typed, kept so the expense can be edited as it was entered.
  baseAmountInput    String    @default("") @map("base_amount_input")
  taxInput           String    @default("") @map("tax_input")
  extraInput         String    @default("") @map("extra_input")
  notes              String[]  @default([])
  position           Int       @default(0)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)

  workspace Workspace               @relation(fields: [workspaceId], references: [workspaceId], onDelete: Restrict)
  splitBill SplitBill               @relation(fields: [splitBillId], references: [splitBillId], onDelete: Restrict)
  paidBy    SplitBillMember         @relation(fields: [paidByMemberId], references: [splitBillMemberId], onDelete: Restrict)
  shares    SplitBillExpenseShare[]

  @@index([workspaceId])
  @@map("split_bill_expenses")
}

model SplitBillExpenseShare {
  splitBillExpenseShareId String    @id @default(dbgenerated("gen_random_uuid()")) @map("split_bill_expense_share_id") @db.Uuid
  workspaceId             String    @map("workspace_id") @db.Uuid
  splitBillExpenseId      String    @map("split_bill_expense_id") @db.Uuid
  splitBillMemberId       String    @map("split_bill_member_id") @db.Uuid
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt               DateTime? @map("deleted_at") @db.Timestamptz(3)

  workspace Workspace        @relation(fields: [workspaceId], references: [workspaceId], onDelete: Restrict)
  expense   SplitBillExpense @relation(fields: [splitBillExpenseId], references: [splitBillExpenseId], onDelete: Restrict)
  member    SplitBillMember  @relation(fields: [splitBillMemberId], references: [splitBillMemberId], onDelete: Restrict)

  @@index([workspaceId])
  @@map("split_bill_expense_shares")
}

model SplitBillSettlement {
  splitBillSettlementId String    @id @default(dbgenerated("gen_random_uuid()")) @map("split_bill_settlement_id") @db.Uuid
  workspaceId           String    @map("workspace_id") @db.Uuid
  splitBillId           String    @map("split_bill_id") @db.Uuid
  fromMemberId          String    @map("from_member_id") @db.Uuid
  toMemberId            String    @map("to_member_id") @db.Uuid
  amount                Decimal   @db.Decimal(14, 2)
  settledAt             DateTime  @default(now()) @map("settled_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(3)

  workspace Workspace       @relation(fields: [workspaceId], references: [workspaceId], onDelete: Restrict)
  splitBill SplitBill       @relation(fields: [splitBillId], references: [splitBillId], onDelete: Restrict)
  from      SplitBillMember @relation("SettlementFrom", fields: [fromMemberId], references: [splitBillMemberId], onDelete: Restrict)
  to        SplitBillMember @relation("SettlementTo", fields: [toMemberId], references: [splitBillMemberId], onDelete: Restrict)

  @@index([workspaceId])
  @@map("split_bill_settlements")
}

/// A moment someone on a trip kept: the place, the day, a note, a rating, and a photo in object storage.
model TripMemory {
  tripMemoryId   String    @id @default(dbgenerated("gen_random_uuid()")) @map("trip_memory_id") @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  tripId         String    @map("trip_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  authorName     String    @default("") @map("author_name")
  placeTitle     String    @map("place_title")
  dayNumber      Int       @map("day_number") @db.SmallInt
  note           String    @default("")
  rating         Int?      @db.SmallInt
  photoObjectKey String?   @map("photo_object_key")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [workspaceId], onDelete: Restrict)
  trip      Trip      @relation(fields: [tripId], references: [tripId], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [userId], onDelete: Restrict)

  @@index([workspaceId])
  @@map("trip_memories")
}

/// A trip's field pass, generated once and shared by the group instead of once per device.
model TripFieldPass {
  tripFieldPassId String    @id @default(dbgenerated("gen_random_uuid()")) @map("trip_field_pass_id") @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  tripId          String    @map("trip_id") @db.Uuid
  locale          String    @default("id")
  payload         Json
  generatedAt     DateTime  @default(now()) @map("generated_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [workspaceId], onDelete: Restrict)
  trip      Trip      @relation(fields: [tripId], references: [tripId], onDelete: Restrict)

  @@index([workspaceId])
  @@map("trip_field_passes")
}

/// One device an account turned push notifications on with. A device belongs to one account at a time.
model PushSubscription {
  pushSubscriptionId String    @id @default(dbgenerated("gen_random_uuid()")) @map("push_subscription_id") @db.Uuid
  workspaceId        String    @map("workspace_id") @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  /// The device's Firebase token, encrypted before it is stored; see lib/secret-box.ts.
  tokenCipher        String    @map("token_cipher")
  /// A keyed hash of the token, to tell whether a device is already known without reading the token.
  tokenHash          String    @unique @map("token_hash")
  /// The language the device was using when it turned notifications on, which they are written in.
  locale             String    @default("id")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [workspaceId], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [userId], onDelete: Restrict)

  @@index([workspaceId])
  @@map("push_subscriptions")
}

/// One country a person marked on their travel map. Unmarking sets `deletedAt`; marking again clears it.
model VisitedCountry {
  visitedCountryId String    @id @default(dbgenerated("gen_random_uuid()")) @map("visited_country_id") @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  countryCode      String    @map("country_code") @db.Char(2)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [workspaceId], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [userId], onDelete: Restrict)

  @@unique([workspaceId, userId, countryCode])
  @@map("visited_countries")
}

/// Answers from outside services, kept until `expiresAt` so the same question is not paid for twice.
/// Shared by everyone, so it has no workspace.
model ApiCache {
  apiCacheId String   @id @default(dbgenerated("gen_random_uuid()")) @map("api_cache_id") @db.Uuid
  cacheKey   String   @unique @map("cache_key")
  payload    Json
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("api_caches")
}

/// One member of a trip's plan as a person to reach: their number, whether they carry a phone, and the account that
/// joined the trip as them. Who they are (name, age, needs) stays in the trip's plan document. The partial unique
/// index that lets an account be one member per trip exists in the database only.
model TripMember {
  tripMemberId      String    @id @default(dbgenerated("gen_random_uuid()")) @map("trip_member_id") @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  tripId            String    @map("trip_id") @db.Uuid
  /// The member's id inside the plan document.
  memberKey         String    @map("member_key")
  /// The account that joined the trip as this member, when one did.
  userId            String?   @map("user_id") @db.Uuid
  /// Encrypted before it is stored; see lib/secret-box.ts.
  phoneNumberCipher String?   @map("phone_number_cipher")
  hasPhone          Boolean   @default(true) @map("has_phone")
  /// When someone confirmed this member's meeting card was saved or printed.
  cardSavedAt       DateTime? @map("card_saved_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  workspace       Workspace       @relation(fields: [workspaceId], references: [workspaceId], onDelete: Restrict)
  trip            Trip            @relation(fields: [tripId], references: [tripId], onDelete: Restrict)
  user            User?           @relation(fields: [userId], references: [userId], onDelete: Restrict)
  searchesFor     MissingReport[] @relation("MissingMember")
  searchesStarted MissingReport[] @relation("ReportingMember")

  @@unique([tripId, memberKey])
  @@index([workspaceId])
  @@map("trip_members")
}

/// What a trip keeps for finding someone: the second number printed on the meeting cards, the meeting point, and
/// the version of its invite link (raising it makes every earlier link stop working).
model TripSafetySetting {
  tripSafetySettingId        String    @id @default(dbgenerated("gen_random_uuid()")) @map("trip_safety_setting_id") @db.Uuid
  workspaceId                String    @map("workspace_id") @db.Uuid
  tripId                     String    @unique @map("trip_id") @db.Uuid
  /// Encrypted before it is stored; see lib/secret-box.ts.
  secondaryPhoneNumberCipher String?   @map("secondary_phone_number_cipher")
  inviteVersion              Int       @default(1) @map("invite_version")
  meetingPointLabel          String?   @map("meeting_point_label")
  meetingPointNote           String?   @map("meeting_point_note")
  /// Taken from the phone of the member who set the point, never from a map service.
  meetingPointLatitude       Float?    @map("meeting_point_latitude")
  meetingPointLongitude      Float?    @map("meeting_point_longitude")
  meetingPointSetAt          DateTime? @map("meeting_point_set_at") @db.Timestamptz(3)
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                  DateTime? @map("deleted_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [workspaceId], onDelete: Restrict)
  trip      Trip      @relation(fields: [tripId], references: [tripId], onDelete: Restrict)

  @@index([workspaceId])
  @@map("trip_safety_settings")
}

/// One search for one member, from the moment someone asks for help until the member is found. A member has one
/// open search at a time (a partial unique index in the database). The location is shared once, by consent.
model MissingReport {
  missingReportId        String    @id @default(dbgenerated("gen_random_uuid()")) @map("missing_report_id") @db.Uuid
  workspaceId            String    @map("workspace_id") @db.Uuid
  tripId                 String    @map("trip_id") @db.Uuid
  missingTripMemberId    String    @map("missing_trip_member_id") @db.Uuid
  /// Empty when a finder, who is no member, started the search.
  reportedByTripMemberId String?   @map("reported_by_trip_member_id") @db.Uuid
  /// SOS, TRIP_LEAD, or FINDER.
  source                 String    @db.VarChar(15)
  /// SEARCHING, ON_THE_WAY, or FOUND.
  status                 String    @db.VarChar(15)
  /// When the missing member answered that they are lost.
  confirmedLostAt        DateTime? @map("confirmed_lost_at") @db.Timestamptz(3)
  sharedLatitude         Float?    @map("shared_latitude")
  sharedLongitude        Float?    @map("shared_longitude")
  sharedAt               DateTime? @map("shared_at") @db.Timestamptz(3)
  resolvedAt             DateTime? @map("resolved_at") @db.Timestamptz(3)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(3)

  workspace     Workspace   @relation(fields: [workspaceId], references: [workspaceId], onDelete: Restrict)
  trip          Trip        @relation(fields: [tripId], references: [tripId], onDelete: Restrict)
  missingMember TripMember  @relation("MissingMember", fields: [missingTripMemberId], references: [tripMemberId], onDelete: Restrict)
  reportedBy    TripMember? @relation("ReportingMember", fields: [reportedByTripMemberId], references: [tripMemberId], onDelete: Restrict)

  @@index([tripId, status, createdAt(sort: Desc)])
  @@index([workspaceId])
  @@map("missing_reports")
}

/// A number the group can call at a place on the trip: an information desk, security, the lodging's front desk.
/// National emergency numbers are not rows here; they ship inside the app so they work without a connection.
model EmergencyContact {
  emergencyContactId String    @id @default(dbgenerated("gen_random_uuid()")) @map("emergency_contact_id") @db.Uuid
  workspaceId        String    @map("workspace_id") @db.Uuid
  tripId             String    @map("trip_id") @db.Uuid
  placeName          String    @map("place_name")
  /// INFO_DESK, SECURITY, LODGING, GUIDE, or OTHER.
  labelKey           String    @map("label_key") @db.VarChar(30)
  phoneNumber        String    @map("phone_number") @db.VarChar(20)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [workspaceId], onDelete: Restrict)
  trip      Trip      @relation(fields: [tripId], references: [tripId], onDelete: Restrict)

  @@index([workspaceId])
  @@map("emergency_contacts")
}
